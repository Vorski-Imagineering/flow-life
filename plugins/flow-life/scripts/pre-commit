#!/bin/sh
# flow-life pre-commit check, called by the shim in the adopting repo's .githooks/.
# 1. Records in immutable folders are append-only: new files and whole-file moves
#    are fine, edits and deletions are not.
# 2. check_repo.py must pass (file modes are repaired first; git does not keep them).
here=$(cd "$(dirname "$0")" && pwd)
root=$(git rev-parse --show-toplevel) || exit 1
dirs=$(cd "$root" && python3 -c 'import sys; sys.path.insert(0, sys.argv[1]); import flowconfig; c = flowconfig.load_or_exit(); print("|".join(sorted(c.immutable_dirs)))' "$here") || exit 1

bad=$(git diff --cached --name-status -M --diff-filter=MDR |
  awk -F'\t' -v dirs="$dirs" '$1 != "R100" && $2 ~ ("(^|/)(" dirs ")/")')
if [ -n "$bad" ]; then
  echo "pre-commit: immutable records were edited or deleted:" >&2
  echo "$bad" >&2
  exit 1
fi

cd "$root" && python3 "$here/check_repo.py" --fix-modes || {
  echo "pre-commit: fix the problems above (/flow-life:status explains them)" >&2
  exit 1
}
